<% content_for :page_header do %>
  <div class="space-y-4 mb-6">
    <div class="flex justify-between items-center">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <%= link_to investments_path, class: "text-secondary hover:text-primary" do %>
            <%= icon("arrow-left", size: "sm") %>
          <% end %>
          <h1 class="text-xl lg:text-3xl font-medium text-primary">
            <%= @account.name %>
          </h1>
        </div>
        <p class="text-sm lg:text-base text-secondary">
          <%= t(".subtitle") %>
        </p>
      </div>
      <div class="flex items-center gap-2">
        <%= render DS::Link.new(
          text: t(".import_csv"),
          href: new_import_path(type: "InvestmentImport", account_id: @account.id),
          variant: "secondary",
          icon: "upload",
          frame: :modal
        ) %>
        <%= render DS::Link.new(
          text: t(".edit"),
          href: edit_investment_path(@account),
          variant: "ghost",
          icon: "pencil",
          frame: :modal
        ) %>
      </div>
    </div>
  </div>
<% end %>

<div class="space-y-6">
  <%# Portfolio Metrics Card %>
  <div class="bg-container rounded-xl shadow-border-xs p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-medium text-primary"><%= t(".portfolio_metrics") %></h2>
      <div class="flex items-center gap-2">
        <span class="text-sm text-secondary"><%= t(".benchmark") %>:</span>
        <%= form_with url: update_benchmark_investment_path(@account), method: :patch, class: "flex items-center gap-2" do |f| %>
          <%= f.select :benchmark_ticker,
            options_for_select(InvestmentMetrics::BenchmarkCalculator.supported_benchmarks, @investment.benchmark_ticker_display),
            {},
            class: "text-sm bg-surface-inset border border-primary rounded px-2 py-1 text-primary",
            onchange: "this.form.submit()" %>
        <% end %>
      </div>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      <div>
        <p class="text-sm text-secondary"><%= t(".total_invested") %></p>
        <p class="text-xl font-medium text-primary">
          <%= number_to_currency(@portfolio_metrics[:total_invested], unit: Money::Currency.new(@account.currency).symbol) %>
        </p>
      </div>
      <div>
        <p class="text-sm text-secondary"><%= t(".current_value") %></p>
        <p class="text-xl font-medium text-primary">
          <%= number_to_currency(@portfolio_metrics[:total_market_value], unit: Money::Currency.new(@account.currency).symbol) %>
        </p>
      </div>
      <div>
        <p class="text-sm text-secondary"><%= t(".portfolio_cagr") %></p>
        <% if @portfolio_metrics[:cagr_percent].present? %>
          <p class="text-xl font-medium <%= @portfolio_metrics[:cagr_percent] >= 0 ? "text-success" : "text-destructive" %>">
            <%= number_to_percentage(@portfolio_metrics[:cagr_percent], precision: 2) %>
          </p>
        <% else %>
          <p class="text-xl font-medium text-secondary">--</p>
        <% end %>
      </div>
      <div>
        <p class="text-sm text-secondary"><%= t(".inception_date") %></p>
        <p class="text-xl font-medium text-primary">
          <% if @portfolio_metrics[:inception_date] %>
            <%= l(@portfolio_metrics[:inception_date], format: :short) %>
          <% else %>
            --
          <% end %>
        </p>
      </div>
    </div>
  </div>

  <%# Positions List %>
  <div class="bg-container rounded-xl shadow-border-xs">
    <div class="flex items-center justify-between p-4 border-b border-primary">
      <h2 class="font-medium text-primary"><%= t(".positions") %></h2>
      <p class="text-sm text-secondary"><%= t(".positions_count", count: @positions.count) %></p>
    </div>

    <% if @positions.any? %>
      <div class="divide-y divide-primary">
        <% @positions.each do |position| %>
          <div class="p-4 hover:bg-surface-inset transition-colors">
            <div class="grid grid-cols-12 gap-4 items-center">
              <div class="col-span-2">
                <p class="font-medium text-primary"><%= position.ticker %></p>
                <p class="text-sm text-secondary"><%= position.inception_date&.strftime("%b %Y") %></p>
              </div>
              <div class="col-span-2 text-right">
                <p class="text-sm text-secondary"><%= t(".quantity") %></p>
                <p class="font-medium text-primary"><%= number_with_precision(position.current_quantity, precision: 2) %></p>
              </div>
              <div class="col-span-2 text-right">
                <p class="text-sm text-secondary"><%= t(".cost_basis") %></p>
                <p class="font-medium text-primary">
                  <%= number_to_currency(position.cost_basis_total, unit: Money::Currency.new(@account.currency).symbol) %>
                </p>
              </div>
              <div class="col-span-2 text-right">
                <p class="text-sm text-secondary"><%= t(".cagr") %></p>
                <% position_cagr = position.cagr_percent || position.cagr %>
                <% if position_cagr.present? %>
                  <p class="font-medium <%= position_cagr >= 0 ? "text-success" : "text-destructive" %>">
                    <%= number_to_percentage(position_cagr, precision: 1) %>
                  </p>
                <% else %>
                  <p class="font-medium text-secondary">--</p>
                <% end %>
              </div>
              <div class="col-span-2 text-right">
                <p class="text-sm text-secondary">vs <%= @investment.benchmark_ticker_display %></p>
                <% position_alpha = position.alpha %>
                <% if position_alpha.present? %>
                  <p class="font-medium <%= position_alpha >= 0 ? "text-success" : "text-destructive" %>">
                    <%= position_alpha >= 0 ? "+" : "" %><%= number_to_percentage(position_alpha, precision: 1) %>
                  </p>
                <% else %>
                  <p class="font-medium text-secondary">--</p>
                <% end %>
              </div>
              <div class="col-span-2 text-right">
                <p class="text-sm text-secondary"><%= t(".transactions_count") %></p>
                <p class="font-medium text-primary"><%= position.investment_transactions.count %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-8 text-center">
        <p class="text-secondary"><%= t(".no_positions") %></p>
        <p class="text-sm text-secondary mt-2"><%= t(".import_hint") %></p>
      </div>
    <% end %>
  </div>

  <%# Recent Transactions %>
  <div class="bg-container rounded-xl shadow-border-xs">
    <div class="flex items-center justify-between p-4 border-b border-primary">
      <h2 class="font-medium text-primary"><%= t(".recent_transactions") %></h2>
    </div>

    <% if @recent_transactions.any? %>
      <div class="divide-y divide-primary">
        <% @recent_transactions.each do |txn| %>
          <div class="p-4 hover:bg-surface-inset transition-colors">
            <div class="grid grid-cols-12 gap-4 items-center">
              <div class="col-span-2">
                <p class="text-sm text-primary"><%= txn.transaction_date.strftime("%b %d, %Y") %></p>
              </div>
              <div class="col-span-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                  <%= case txn.transaction_type
                      when "buy" then "bg-success-surface text-success"
                      when "sell" then "bg-destructive-surface text-destructive"
                      when "dividend", "capital_gain", "interest" then "bg-warning-surface text-warning"
                      when "other" then "bg-destructive-surface text-destructive"
                      when "tax_withheld", "fee" then "bg-surface-inset text-secondary"
                      else "bg-surface-inset text-secondary"
                      end %>">
                  <% if txn.other? && txn.original_type %>
                    <%= icon("alert-triangle", size: "xs", class: "mr-1") %>
                    <%= txn.original_type %>
                  <% else %>
                    <%= t(".transaction_types.#{txn.transaction_type}") %>
                  <% end %>
                </span>
                <% if txn.needs_review? %>
                  <p class="text-xs text-destructive mt-1"><%= t(".needs_review") %></p>
                <% end %>
              </div>
              <div class="col-span-2">
                <p class="font-medium text-primary"><%= txn.ticker || "--" %></p>
              </div>
              <div class="col-span-2 text-right">
                <p class="text-sm text-secondary"><%= t(".qty") %></p>
                <p class="font-medium text-primary"><%= txn.quantity ? number_with_precision(txn.quantity, precision: 2) : "--" %></p>
              </div>
              <div class="col-span-2 text-right">
                <p class="text-sm text-secondary"><%= t(".price") %></p>
                <p class="font-medium text-primary">
                  <%= txn.price_per_unit ? number_to_currency(txn.price_per_unit, unit: Money::Currency.new(@account.currency).symbol) : "--" %>
                </p>
              </div>
              <div class="col-span-2 text-right">
                <p class="font-medium <%= txn.amount >= 0 ? "text-success" : "text-destructive" %>">
                  <%= number_to_currency(txn.amount.abs, unit: Money::Currency.new(@account.currency).symbol) %>
                </p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-8 text-center">
        <p class="text-secondary"><%= t(".no_transactions") %></p>
      </div>
    <% end %>
  </div>
</div>
